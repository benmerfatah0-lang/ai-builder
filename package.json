{
  "name": "ai-world-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first, AI-assisted 3D world builder for the browser",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:export": "tsx scripts/exportSchema.ts",
    "render:preview": "tsx scripts/renderPreview.ts",
    "site": "node website/server.mjs",
    "site:demo": "esbuild website/src/demo.ts --bundle --minify --format=esm --target=es2020 --legal-comments=none --outfile=website/public/demo.js",
    "site:demo:watch": "esbuild website/src/demo.ts --bundle --format=esm --target=es2020 --outfile=website/public/demo.js --watch",
    "site:app": "tsc --noEmit && vite build --base=/app/ --outDir=website/public/app --emptyOutDir",
    "site:build": "npm run site:demo && npm run site:app",
    "map:render": "tsx scripts/renderGameMap.ts --view overview && tsx scripts/renderGameMap.ts --view top && tsx scripts/renderGameMap.ts --view start && tsx scripts/renderGameMap.ts --view farm && tsx scripts/renderGameMap.ts --view crops && tsx scripts/renderGameMap.ts --view pens && tsx scripts/renderGameMap.ts --view finale",
    "map:paper": "tsx scripts/renderPaperMap.ts",
    "map:all": "npm run map:paper && npm run map:render && npm run map:page",
    "map:page": "tsx scripts/renderMapPage.ts",
    "map:dev": "MAP_PREVIEW=1 vite --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.2.2",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
